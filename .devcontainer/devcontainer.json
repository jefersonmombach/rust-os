{
  "name": "rust-os",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
  "containerEnv": {
    "RUSTUP_TOOLCHAIN": "nightly"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "postCreateCommand": "rustup toolchain install nightly && rustc --version && cargo --version"
}
