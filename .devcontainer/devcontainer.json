{
  "name": "rust-os",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "RUSTUP_TOOLCHAIN": "nightly"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "postCreateCommand": "rustup toolchain install nightly && rustc --version && cargo --version"
}
